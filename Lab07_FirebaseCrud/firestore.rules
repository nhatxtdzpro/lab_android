rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lab thực hành CRUD không đăng nhập: collection students dùng chung.
    // Các đường dẫn khác không được cấp quyền bởi file rules này.
    match /students/{studentId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'studentCode', 'score'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.studentCode is string
        && request.resource.data.studentCode.size() > 0
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10;
    }
  }
}
