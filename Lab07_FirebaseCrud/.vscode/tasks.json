{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build APK Lab 7",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [":app:assembleDebug", "--console=plain"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\JetBrains\\IntelliJ IDEA 2023.2.5\\jbr"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Cài APK Lab 7 lên LDPlayer",
      "type": "process",
      "command": "D:\\DATAAPP\\Android\\platform-tools\\adb.exe",
      "args": [
        "-s", "emulator-5554", "install", "--no-streaming", "-r",
        "${workspaceFolder}\\app\\build\\outputs\\apk\\debug\\app-debug.apk"
      ],
      "dependsOn": "Build APK Lab 7",
      "problemMatcher": []
    },
    {
      "label": "Build và chạy Lab 7 trên LDPlayer",
      "type": "process",
      "command": "D:\\DATAAPP\\Android\\platform-tools\\adb.exe",
      "args": [
        "-s", "emulator-5554", "shell", "am", "start", "-W", "-n",
        "com.thanhnhat.firebasecrud/.MainActivity"
      ],
      "dependsOn": "Cài APK Lab 7 lên LDPlayer",
      "problemMatcher": []
    }
  ]
}
